{
  "name": "kiln",
  "version": "1.0.0",
  "private": true,
  "description": "Kiln is a browser-first coding agent. Agentic behavior is ported from the Claude Code repository in this tree; the interface, runtime, and local bridge are an original implementation.",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "bridge": "tsx bridge/src/server.ts",
    "dev:all": "concurrently -n bridge,web -c cyan,magenta \"npm run bridge -- --suggested-root ./sample-project\" \"npm run dev\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-commands": "tsx scripts/extract-commands.ts",
    "verify": "vitest run && tsc --noEmit"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.5.1",
    "diff": "^7.0.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
